{
    "name": "rdb",
    "version": "1.0.0",
    "description": "Ramaaz Digital Banking Library",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "browser": "./dist/server/browser.mjs",
            "import": "./dist/server/index.mjs",
            "require": "./dist/server/index.js"
        },
        "./core": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.mjs",
            "require": "./dist/core/index.js"
        },
        "./styles": "./dist/styles/styles.css"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "concurrently -n proxy,web -c cyan,green \"node ./scripts/local-proxy.mjs\" \"cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --port 3000\"",
        "dev:https": "concurrently -n proxy,web -c cyan,green \"node ./scripts/local-proxy.mjs\" \"cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --port 3000 --experimental-https\"",
        "dev:mobile": "concurrently -n proxy,web -c cyan,green \"node ./scripts/local-proxy.mjs\" \"next dev -H 0.0.0.0 --port 3000 --experimental-https\"",
        "dev:next-only": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --port 3000",
        "build": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
        "build:next": "next build --webpack",
        "deploy": "npm run build && wrangler deploy",
        "start": "next start",
        "lint": "next lint",
        "clean": "rimraf dist",
        "lib:build": "npm run clean && tsup && npm run css:build",
        "css:build": "npx @tailwindcss/cli -i ./src/styles/styles.css -o ./dist/styles/styles.css --minify",
        "cf:build": "npm run lib:build && npx @cloudflare/next-on-pages",
        "pages:deploy": "npm run cf:build && wrangler pages deploy .vercel/output/static",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "sync:vendor": "node ./scripts/sync-vendor.mjs",
        "postinstall": "node ./scripts/sync-vendor.mjs"
    },
    "dependencies": {
        "@mediapipe/tasks-vision": "^0.10.34",
        "@opennextjs/cloudflare": "1.20.1",
        "@simplewebauthn/browser": "^13.3.0",
        "@tailwindcss/postcss": "^4.1.18",
        "axios": "1.13.5",
        "framer-motion": "^12.29.2",
        "html2canvas": "^1.4.1",
        "js-cookie": "^3.0.5",
        "js-cookies": "^1.0.4",
        "lucide-react": "^0.563.0",
        "qr-scanner": "^1.4.2",
        "qrcode": "^1.5.4",
        "react-loading-skeleton": "^3.3.1",
        "react-router-dom": "^7.13.0",
        "socket.io-client": "^4.8.3",
        "xd-config": "github:Yazan-Rammaz/xd-config"
    },
    "peerDependencies": {
        "next": ">=14",
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "concurrently": "^10.0.1",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^20",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "autoprefixer": "^10.4.24",
        "cross-env": "^10.1.0",
        "next": "16.2.10",
        "postcss": "^8.5.6",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "rimraf": "^5.0.0",
        "tailwindcss": "^4.1.18",
        "tsup": "^8.5.1",
        "typescript": "^5",
        "wrangler": "^4.71.0"
    }
}
