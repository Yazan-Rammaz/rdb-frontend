{
  "name": "rdb",
  "version": "1.0.0",
  "description": "Ramaaz Digital Banking Library",
  "scripts": {
    "dev": "concurrently -n proxy,web -c cyan,green \"node ./scripts/local-proxy.mjs\" \"cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --port 3000\"",
    "dev:https": "concurrently -n proxy,web -c cyan,green \"node ./scripts/local-proxy.mjs\" \"cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --port 3000 --experimental-https\"",
    "dev:mobile": "concurrently -n proxy,web -c cyan,green \"node ./scripts/local-proxy.mjs\" \"next dev -H 0.0.0.0 --port 3000 --experimental-https\"",
    "dev:next-only": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev --port 3000",
    "build": "next build --webpack && npm run check:opacity && opennextjs-cloudflare build --skipNextBuild",
    "build:next": "next build --webpack && npm run check:opacity",
    "deploy": "npm run build && wrangler deploy",
    "start": "next start",
    "lint": "next lint",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "sync:vendor": "node ./scripts/sync-vendor.mjs",
    "postinstall": "node ./scripts/sync-vendor.mjs",
    "check:opacity": "node ./scripts/check-bundle-opacity.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "@opennextjs/cloudflare": "1.20.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "axios": "1.13.5",
    "framer-motion": "^12.29.2",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "js-cookies": "^1.0.4",
    "lucide-react": "^0.563.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react-loading-skeleton": "^3.3.1",
    "socket.io-client": "^4.8.3",
    "xd-config": "github:Yazan-Rammaz/xd-config"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "concurrently": "^10.0.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "next": "16.2.10",
    "postcss": "^8.5.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "wrangler": "^4.71.0"
  },
  "private": true
}
