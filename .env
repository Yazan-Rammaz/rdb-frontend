# Committed defaults for all environments (override in .env.local / CI env).
# Route API calls through Next.js Server Actions ('use server' in core/server.ts)
# instead of direct client-side fetches. Build-time inlined (NEXT_PUBLIC_*).
NEXT_PUBLIC_USE_SERVER_ACTIONS=true

# Opaque API mode (default ON): session/auth/reset-passcode/reverify calls go
# through the random-hash opcode gateway so no descriptive endpoint names show
# in the Network tab, and the named routes 404 to direct hits. Set to false
# (in .env.local, then rebuild/restart dev) to call the real endpoints while
# debugging. Build-time inlined (NEXT_PUBLIC_*).
